# Backend Environment Variables - MySQL
# Copy this file to .env and fill in the values

# Database - MySQL connection (Railway MySQL or local)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=reporta_ya

# Frontend URL for CORS (production: Vercel URL, local: http://localhost:5173)
FRONTEND_URL=http://localhost:5173

# Server port (Railway sets PORT automatically)
PORT=3001

# Environment
NODE_ENV=development
